{
  "name": "dsh-archive-manager",
  "version": "0.10.2",
  "description": "Archived-conversation manager for DeepSeek Harness: a colour-coded sidebar panel that lists archived conversations grouped under collapsible workspace headings, with per-row, per-workspace and bulk restore plus permanent delete. Adds one Host Remote for deletion and is otherwise a client-only UI plugin for DSH 0.2.x and newer.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/client.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "archive",
    "conversation",
    "sidebar",
    "delete"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-0"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-0 <1.0.0"
  }
}
