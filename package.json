{
  "name": "dsh-archive-manager",
  "version": "0.5.0",
  "description": "Archived-conversation manager for DeepSeek Harness: view (grouped by workspace), restore (single or bulk), and reveal transcript folders of archived conversations. Works on DSH 0.2.x (desktop) and 0.1.x (web).",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "archive",
    "conversation"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-gateway": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-workspace": ">=0.1.0-rc.6"
  },
  "engines": {
    "node": ">=20"
  }
}
